#!/bin/bash
# Restic Restore Helper Script
# Created: 2025-11-29
# Interactive script to browse and restore from backups

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Load environment configuration
if [[ ! -f "/home/tomge/.config/restic/env" ]]; then
    echo -e "${RED}ERROR:${NC} Configuration file not found: /home/tomge/.config/restic/env"
    exit 1
fi

source /home/tomge/.config/restic/env

# Verify password file exists
if [[ ! -f "$RESTIC_PASSWORD_FILE" ]]; then
    echo -e "${RED}ERROR:${NC} Password file not found: $RESTIC_PASSWORD_FILE"
    exit 1
fi

# Verify repository exists
if [[ ! -d "$RESTIC_REPOSITORY" ]]; then
    echo -e "${RED}ERROR:${NC} Repository not found: $RESTIC_REPOSITORY"
    exit 1
fi

echo -e "${BLUE}=== Restic Restore Helper ===${NC}\n"

# Function to list snapshots
list_snapshots() {
    echo -e "${GREEN}Available snapshots:${NC}\n"
    restic snapshots
}

# Function to show snapshot content
show_snapshot() {
    local snapshot_id=$1
    echo -e "${GREEN}Contents of snapshot $snapshot_id:${NC}\n"
    restic ls "$snapshot_id" | less
}

# Function to restore entire snapshot
restore_snapshot() {
    local snapshot_id=$1
    local target_dir=$2

    echo -e "${YELLOW}WARNING:${NC} This will restore snapshot $snapshot_id to $target_dir"
    read -p "Continue? (y/N) " -n 1 -r
    echo

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        mkdir -p "$target_dir"
        echo -e "${GREEN}Restoring snapshot...${NC}"
        restic restore "$snapshot_id" --target "$target_dir"
        echo -e "${GREEN}Restore complete!${NC}"
    else
        echo "Restore cancelled."
    fi
}

# Function to restore specific path
restore_path() {
    local snapshot_id=$1
    local path=$2
    local target_dir=$3

    echo -e "${GREEN}Restoring $path from snapshot $snapshot_id to $target_dir${NC}"
    mkdir -p "$target_dir"
    restic restore "$snapshot_id" --target "$target_dir" --path "$path"
    echo -e "${GREEN}Restore complete!${NC}"
}

# Main menu
while true; do
    echo -e "\n${BLUE}Choose an option:${NC}"
    echo "1) List all snapshots"
    echo "2) Show snapshot contents"
    echo "3) Restore entire snapshot to directory"
    echo "4) Restore specific file/directory"
    echo "5) Mount snapshot (read-only)"
    echo "6) Show repository stats"
    echo "7) Exit"
    echo
    read -p "Enter choice [1-7]: " choice

    case $choice in
        1)
            list_snapshots
            ;;
        2)
            read -p "Enter snapshot ID (or 'latest'): " snapshot_id
            show_snapshot "$snapshot_id"
            ;;
        3)
            read -p "Enter snapshot ID (or 'latest'): " snapshot_id
            read -p "Enter target directory: " target_dir
            restore_snapshot "$snapshot_id" "$target_dir"
            ;;
        4)
            read -p "Enter snapshot ID (or 'latest'): " snapshot_id
            read -p "Enter path to restore (e.g., /home/tomge/Documents): " path
            read -p "Enter target directory: " target_dir
            restore_path "$snapshot_id" "$path" "$target_dir"
            ;;
        5)
            read -p "Enter snapshot ID (or 'latest'): " snapshot_id
            read -p "Enter mount point: " mount_point
            mkdir -p "$mount_point"
            echo -e "${GREEN}Mounting snapshot at $mount_point${NC}"
            echo -e "${YELLOW}Press Ctrl+C when done browsing${NC}"
            restic mount "$mount_point" "$snapshot_id"
            ;;
        6)
            echo -e "${GREEN}Repository statistics:${NC}\n"
            restic stats
            ;;
        7)
            echo "Goodbye!"
            exit 0
            ;;
        *)
            echo -e "${RED}Invalid choice${NC}"
            ;;
    esac
done
