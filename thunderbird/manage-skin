#!/usr/bin/env bash
set -euo pipefail

readonly EXPECTED_VERSION='153.0.2'
readonly EXPECTED_BUILD_ID='20260813184934'
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly PACKAGES_DIR="$SCRIPT_DIR/packages"
readonly DEFAULT_PROFILE_ROOT="$HOME/.thunderbird"
readonly DEFAULT_APPLICATION_INI='/usr/lib/thunderbird/application.ini'
readonly DEFAULT_STOW_TIMEOUT_SECONDS=30

PROFILE_ROOT="$DEFAULT_PROFILE_ROOT"
APPLICATION_INI="$DEFAULT_APPLICATION_INI"
STOW_BIN=''
TIMEOUT_BIN=''
STOW_TIMEOUT_SECONDS="$DEFAULT_STOW_TIMEOUT_SECONDS"
EXPLICIT_PROFILE=''
TRANSACTION_ACTIVE=0
ROLLBACK_ACTIVE=0
TRANSACTION_INITIAL_ENABLE=''
TRANSACTION_INITIAL_VARIANT=''

die() {
  printf 'manage-skin: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: manage-skin [--profile PATH] status
       manage-skin [--profile PATH] install outlook|rose-pine
       manage-skin [--profile PATH] switch outlook|rose-pine
       manage-skin [--profile PATH] uninstall

Without --profile, the command resolves exactly one Default= value from an
[Install...] section in ~/.thunderbird/profiles.ini. --profile must resolve
inside that profile root. The fixture-only THUNDERBIRD_* override variables
are accepted only with THUNDERBIRD_MANAGE_SKIN_TESTING=1. Every Stow command
is bounded by timeout (30 seconds by default); fixtures may set
THUNDERBIRD_STOW_TIMEOUT_SECONDS when testing is enabled.
EOF
}

configure_test_seams() {
  local test_mode="${THUNDERBIRD_MANAGE_SKIN_TESTING:-}"
  if [[ "$test_mode" == '1' ]]; then
    PROFILE_ROOT="${THUNDERBIRD_PROFILE_ROOT:-$DEFAULT_PROFILE_ROOT}"
    APPLICATION_INI="${THUNDERBIRD_APPLICATION_INI:-$DEFAULT_APPLICATION_INI}"
    STOW_BIN="${THUNDERBIRD_STOW_BIN:-}"
    STOW_TIMEOUT_SECONDS="${THUNDERBIRD_STOW_TIMEOUT_SECONDS:-$DEFAULT_STOW_TIMEOUT_SECONDS}"
    return
  fi

  [[ -z "$test_mode" ]] || die 'THUNDERBIRD_MANAGE_SKIN_TESTING must be 1 when set'
  [[ -z "${THUNDERBIRD_PROFILE_ROOT:-}" ]] || die 'THUNDERBIRD_PROFILE_ROOT is test-only; set THUNDERBIRD_MANAGE_SKIN_TESTING=1'
  [[ -z "${THUNDERBIRD_APPLICATION_INI:-}" ]] || die 'THUNDERBIRD_APPLICATION_INI is test-only; set THUNDERBIRD_MANAGE_SKIN_TESTING=1'
  [[ -z "${THUNDERBIRD_STOW_BIN:-}" ]] || die 'THUNDERBIRD_STOW_BIN is test-only; set THUNDERBIRD_MANAGE_SKIN_TESTING=1'
  [[ -z "${THUNDERBIRD_STOW_TIMEOUT_SECONDS:-}" ]] || die 'THUNDERBIRD_STOW_TIMEOUT_SECONDS is test-only; set THUNDERBIRD_MANAGE_SKIN_TESTING=1'
  [[ -z "${THUNDERBIRD_TEST_RUNNING:-}" ]] || die 'THUNDERBIRD_TEST_RUNNING is test-only; set THUNDERBIRD_MANAGE_SKIN_TESTING=1'
}

canonical_directory() {
  local path=$1
  [[ -d "$path" ]] || die "directory does not exist: $path"
  realpath -e -- "$path"
}

resolve_profile_name() {
  local profiles_ini="$PROFILE_ROOT/profiles.ini"
  local result count name
  [[ -f "$profiles_ini" ]] || die "profiles.ini is missing: $profiles_ini"

  result="$(awk -F= '
    BEGIN { count = 0; value = "" }
    /^\[/{ section = $0; next }
    section ~ /^\[Install[^]]*\]$/ && $1 == "Default" {
      count++
      value = $2
    }
    END {
      if (count == 1 && value != "") print value
      else exit 1
    }
  ' "$profiles_ini")" || die 'automatic profile selection requires exactly one nonempty Default= in [Install...] sections; use --profile PATH'

  [[ "$result" != */* && "$result" != '.' && "$result" != '..' && "$result" != *'..'* ]] || die "install-selected profile name is unsafe: $result"
  printf '%s\n' "$result"
}

resolve_profile() {
  local root candidate
  root="$(canonical_directory "$PROFILE_ROOT")"
  PROFILE_ROOT="$root"

  if [[ -n "$EXPLICIT_PROFILE" ]]; then
    if [[ "$EXPLICIT_PROFILE" = /* ]]; then
      candidate="$EXPLICIT_PROFILE"
    else
      candidate="$PROFILE_ROOT/$EXPLICIT_PROFILE"
    fi
  else
    candidate="$PROFILE_ROOT/$(resolve_profile_name)"
  fi

  PROFILE="$(canonical_directory "$candidate")"
  [[ "$PROFILE" == "$PROFILE_ROOT"/* ]] || die "profile is outside Thunderbird profile root: $PROFILE"
  [[ -f "$PROFILE/prefs.js" ]] || die "profile marker prefs.js is missing: $PROFILE/prefs.js"
}

check_application() {
  local version build_id
  [[ -f "$APPLICATION_INI" ]] || die "Thunderbird application.ini is missing: $APPLICATION_INI"
  version="$(awk -F= '
    /^\[/{ section = $0; next }
    section == "[App]" && $1 == "Version" { count++; value = $2 }
    END { if (count == 1) print value; else exit 1 }
  ' "$APPLICATION_INI")" || die 'Thunderbird application.ini must contain exactly one [App] Version='
  build_id="$(awk -F= '
    /^\[/{ section = $0; next }
    section == "[App]" && $1 == "BuildID" { count++; value = $2 }
    END { if (count == 1) print value; else exit 1 }
  ' "$APPLICATION_INI")" || die 'Thunderbird application.ini must contain exactly one [App] BuildID='
  [[ "$version" == "$EXPECTED_VERSION" ]] || die "unsupported Thunderbird version: expected $EXPECTED_VERSION, found ${version:-missing}"
  [[ "$build_id" == "$EXPECTED_BUILD_ID" ]] || die "unsupported Thunderbird BuildID: expected $EXPECTED_BUILD_ID, found ${build_id:-missing}"
}

check_not_running() {
  if [[ "${THUNDERBIRD_MANAGE_SKIN_TESTING:-}" == '1' ]]; then
    case "${THUNDERBIRD_TEST_RUNNING:-0}" in
      0) return ;;
      1) die 'Thunderbird appears to be running; close it completely before changing skins' ;;
      *) die 'THUNDERBIRD_TEST_RUNNING must be 0 or 1' ;;
    esac
  fi

  if pgrep -x thunderbird >/dev/null 2>&1 || pgrep -x thunderbird-bin >/dev/null 2>&1; then
    die 'Thunderbird appears to be running; close it completely before changing skins'
  fi
}

check_stow() {
  if [[ -z "$STOW_BIN" ]]; then
    STOW_BIN="$(command -v stow || true)"
  fi
  [[ -n "$STOW_BIN" && -x "$STOW_BIN" ]] || die 'GNU Stow is required but was not found; install stow and retry'
  TIMEOUT_BIN="$(command -v timeout || true)"
  [[ -n "$TIMEOUT_BIN" && -x "$TIMEOUT_BIN" ]] || die 'coreutils timeout is required to bound GNU Stow operations'
  [[ "$STOW_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || die 'Stow timeout must be a positive whole number of seconds'
}

validate_package_file() {
  local path=$1 resolved packages_root
  packages_root="$(realpath -e -- "$PACKAGES_DIR")"
  [[ -f "$path" && ! -L "$path" ]] || die "required package file is missing or not a regular file: $path"
  resolved="$(realpath -e -- "$path")"
  [[ "$resolved" == "$packages_root"/* ]] || die "package file escapes package root: $path"
}

validate_variant() {
  local variant=$1
  case "$variant" in
    outlook|rose-pine) ;;
    *) die "unknown skin variant: $variant (expected outlook or rose-pine)" ;;
  esac
  validate_package_file "$PACKAGES_DIR/enable/user.js"
  validate_package_file "$PACKAGES_DIR/$variant/chrome/userChrome.css"
}

target_state() {
  local target=$1 expected=$2 actual link_target
  if [[ ! -e "$target" && ! -L "$target" ]]; then
    printf 'absent\n'
    return
  fi
  if [[ ! -L "$target" ]]; then
    printf 'unmanaged\n'
    return
  fi
  link_target="$(readlink -- "$target" 2>/dev/null || true)"
  if [[ "$link_target" == /* ]]; then
    printf 'unmanaged\n'
    return
  fi
  actual="$(realpath -e -- "$target" 2>/dev/null || true)"
  if [[ -n "$actual" && "$actual" == "$(realpath -e -- "$expected" 2>/dev/null || true)" ]]; then
    printf 'managed\n'
  else
    printf 'unmanaged\n'
  fi
}

inspect_ownership() {
  local enable_state css_state variant
  enable_state="$(target_state "$PROFILE/user.js" "$PACKAGES_DIR/enable/user.js")"
  css_state='absent'
  ACTIVE_VARIANT=''

  if [[ -e "$PROFILE/chrome/userChrome.css" || -L "$PROFILE/chrome/userChrome.css" ]]; then
    for variant in outlook rose-pine; do
      if [[ "$(target_state "$PROFILE/chrome/userChrome.css" "$PACKAGES_DIR/$variant/chrome/userChrome.css")" == 'managed' ]]; then
        css_state='managed'
        ACTIVE_VARIANT="$variant"
        break
      fi
    done
    [[ "$css_state" == 'managed' ]] || css_state='unmanaged'
  fi

  [[ "$enable_state" != 'unmanaged' ]] || die "unmanaged user.js at $PROFILE/user.js; preserve it and manually merge user_pref(\"toolkit.legacyUserProfileCustomizations.stylesheets\", true); before retrying"
  [[ "$css_state" != 'unmanaged' ]] || die "unmanaged chrome/userChrome.css at $PROFILE/chrome/userChrome.css; preserve it and manually move or merge it before retrying"
  ENABLE_STATE="$enable_state"
  CSS_STATE="$css_state"
}

stow_command() {
  "$TIMEOUT_BIN" --signal=TERM --kill-after=5s "${STOW_TIMEOUT_SECONDS}s" \
    "$STOW_BIN" --no-folding --dir "$PACKAGES_DIR" --target "$PROFILE" "$@"
}

run_stow() {
  stow_command "$@"
}

simulate_stow() {
  stow_command --simulate "$@"
}

assert_active() {
  local variant=$1
  [[ "$(target_state "$PROFILE/user.js" "$PACKAGES_DIR/enable/user.js")" == 'managed' ]] || return 1
  [[ "$(target_state "$PROFILE/chrome/userChrome.css" "$PACKAGES_DIR/$variant/chrome/userChrome.css")" == 'managed' ]] || return 1
}

assert_absent() {
  [[ ! -e "$PROFILE/user.js" && ! -L "$PROFILE/user.js" ]] || return 1
  [[ ! -e "$PROFILE/chrome/userChrome.css" && ! -L "$PROFILE/chrome/userChrome.css" ]]
}

assert_enable_only() {
  [[ "$(target_state "$PROFILE/user.js" "$PACKAGES_DIR/enable/user.js")" == 'managed' ]] || return 1
  [[ ! -e "$PROFILE/chrome/userChrome.css" && ! -L "$PROFILE/chrome/userChrome.css" ]]
}

assert_initial_state() {
  case "$TRANSACTION_INITIAL_ENABLE:$TRANSACTION_INITIAL_VARIANT" in
    absent:) assert_absent ;;
    managed:) assert_enable_only ;;
    managed:outlook|managed:rose-pine) assert_active "$TRANSACTION_INITIAL_VARIANT" ;;
    *) return 1 ;;
  esac
}

begin_transaction() {
  TRANSACTION_INITIAL_ENABLE="$ENABLE_STATE"
  TRANSACTION_INITIAL_VARIANT="$ACTIVE_VARIANT"
  TRANSACTION_ACTIVE=1
  trap 'handle_signal 130' INT
  trap 'handle_signal 143' TERM
}

finish_transaction() {
  TRANSACTION_ACTIVE=0
  ROLLBACK_ACTIVE=0
  trap - INT TERM
}

restore_initial_state() {
  local failed=0
  ((TRANSACTION_ACTIVE)) || return 0
  ((ROLLBACK_ACTIVE)) && return 1
  ROLLBACK_ACTIVE=1
  trap '' INT TERM

  run_stow -D outlook >/dev/null 2>&1 || failed=1
  run_stow -D rose-pine >/dev/null 2>&1 || failed=1
  case "$TRANSACTION_INITIAL_ENABLE:$TRANSACTION_INITIAL_VARIANT" in
    absent:)
      run_stow -D enable >/dev/null 2>&1 || failed=1
      ;;
    managed:)
      run_stow enable >/dev/null 2>&1 || failed=1
      ;;
    managed:outlook|managed:rose-pine)
      run_stow enable "$TRANSACTION_INITIAL_VARIANT" >/dev/null 2>&1 || failed=1
      ;;
    *)
      failed=1
      ;;
  esac

  if ((failed)) || ! assert_initial_state; then
    return 1
  fi
  return 0
}

abort_transaction() {
  local message=$1
  if ! restore_initial_state; then
    finish_transaction
    die "$message; rollback could not restore the initial managed state"
  fi
  finish_transaction
  die "$message; initial managed state was restored"
}

handle_signal() {
  local signal_status=$1
  if ((TRANSACTION_ACTIVE)) && ! restore_initial_state; then
    finish_transaction
    printf '%s\n' 'manage-skin: interrupted and rollback could not restore the initial managed state' >&2
    exit 1
  fi
  finish_transaction
  printf '%s\n' 'manage-skin: interrupted; initial managed state was restored' >&2
  exit "$signal_status"
}

install_variant() {
  local variant=$1
  validate_variant "$variant"
  inspect_ownership
  [[ -z "$ACTIVE_VARIANT" || "$ACTIVE_VARIANT" == "$variant" ]] || die "a managed $ACTIVE_VARIANT skin is active; use switch $variant"

  simulate_stow enable "$variant" || die 'Stow simulation failed; no profile files were changed'
  begin_transaction
  run_stow enable "$variant" || abort_transaction 'Stow installation failed'
  assert_active "$variant" || abort_transaction 'Stow reported success but did not create the expected package-owned links'
  finish_transaction
  printf 'installed=%s profile=%s\n' "$variant" "$PROFILE"
}

switch_variant() {
  local requested=$1 previous
  validate_variant "$requested"
  inspect_ownership
  [[ "$ENABLE_STATE" == 'managed' && -n "$ACTIVE_VARIANT" ]] || die 'no complete managed skin is active; use install outlook or install rose-pine'
  [[ "$ACTIVE_VARIANT" != "$requested" ]] || {
    printf 'active=%s profile=%s\n' "$requested" "$PROFILE"
    return
  }
  previous="$ACTIVE_VARIANT"
  validate_package_file "$PACKAGES_DIR/$previous/chrome/userChrome.css"

  simulate_stow -D "$previous" -S enable "$requested" || die 'Stow simulation for the remove-and-switch transaction failed; no profile files were changed'
  begin_transaction
  run_stow -D "$previous" || abort_transaction 'Stow removal failed before the requested skin was installed'
  run_stow "$requested" || abort_transaction 'Stow switch failed'
  assert_active "$requested" || abort_transaction 'Stow reported success but did not create the requested package-owned links'
  finish_transaction
  printf 'switched=%s profile=%s\n' "$requested" "$PROFILE"
}

uninstall_skin() {
  local previous
  inspect_ownership
  [[ "$ENABLE_STATE" == 'absent' && -z "$ACTIVE_VARIANT" ]] && {
    printf 'uninstalled=none profile=%s\n' "$PROFILE"
    return
  }
  [[ "$ENABLE_STATE" == 'managed' && -n "$ACTIVE_VARIANT" ]] || die 'managed skin state is incomplete; no files were removed'
  previous="$ACTIVE_VARIANT"
  validate_package_file "$PACKAGES_DIR/enable/user.js"
  validate_package_file "$PACKAGES_DIR/$previous/chrome/userChrome.css"

  simulate_stow -D "$previous" || die 'Stow simulation for skin removal failed; no profile files were changed'
  simulate_stow -D enable || die 'Stow simulation for enablement removal failed; no profile files were changed'
  begin_transaction
  run_stow -D "$previous" || abort_transaction 'Stow skin removal failed'
  run_stow -D enable || abort_transaction 'Stow enablement removal failed'
  assert_absent || abort_transaction 'Stow reported success but managed links remain'
  finish_transaction
  printf 'uninstalled=%s profile=%s\n' "$previous" "$PROFILE"
}

show_status() {
  inspect_ownership
  printf 'profile=%s\n' "$PROFILE"
  printf 'thunderbird=%s BuildID=%s\n' "$EXPECTED_VERSION" "$EXPECTED_BUILD_ID"
  printf 'enablement=%s\n' "$ENABLE_STATE"
  printf 'skin=%s\n' "${ACTIVE_VARIANT:-none}"
}

parse_args() {
  local arg
  local -a positional=()
  while (($#)); do
    arg=$1
    shift
    case "$arg" in
      --profile)
        [[ -z "$EXPLICIT_PROFILE" && $# -gt 0 ]] || die '--profile requires one path and may be used once'
        EXPLICIT_PROFILE=$1
        shift
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*) die "unknown option: $arg" ;;
      *) positional+=("$arg") ;;
    esac
  done

  ((${#positional[@]})) || { usage >&2; exit 1; }
  COMMAND=${positional[0]}
  case "$COMMAND" in
    status|uninstall)
      ((${#positional[@]} == 1)) || die "$COMMAND takes no variant"
      VARIANT=''
      ;;
    install|switch)
      ((${#positional[@]} == 2)) || die "$COMMAND requires outlook or rose-pine"
      VARIANT=${positional[1]}
      ;;
    *) die "unknown command: $COMMAND" ;;
  esac
}

main() {
  configure_test_seams
  parse_args "$@"
  resolve_profile
  check_application

  case "$COMMAND" in
    status) show_status ;;
    install)
      check_not_running
      check_stow
      install_variant "$VARIANT"
      ;;
    switch)
      check_not_running
      check_stow
      switch_variant "$VARIANT"
      ;;
    uninstall)
      check_not_running
      check_stow
      uninstall_skin
      ;;
  esac
}

main "$@"
