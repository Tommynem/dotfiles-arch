// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "model_fallback": false,
    "agents": {
      "build": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "medium"
      },
      "plan": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "sisyphus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "atlas": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium"
      },
      "metis": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "prometheus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "oracle": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "momus": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "medium"
      },
      "librarian": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "low"
      },
      "explore": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "low"
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "low"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "xhigh"
      },
      "deep": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "artistry": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "quick": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "low"
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "low"
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "writing": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "low"
      }
    },
    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification"
  ]
}
