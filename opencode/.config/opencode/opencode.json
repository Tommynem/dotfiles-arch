{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-terra",
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "lsp": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "/home/tomge/.config/opencode/node_modules/.bin/playwright-mcp",
        "--config",
        "/home/tomge/.config/opencode/playwright-mcp.json"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "permission": "allow"
}
