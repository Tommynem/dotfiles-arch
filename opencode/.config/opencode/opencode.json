{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "openai/gpt-5.6-terra",
  "default_agent": "Hephaestus - Deep Agent",
  "agents": {
    "title": { "model": "openai/gpt-5.6-terra" }
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "limit": { "context": 1050000, "input": 272000, "output": 128000 }
        },
        "gpt-6.1-sol": {
          "limit": { "context": 1050000, "input": 500000, "output": 128000 }
        }
      }
    }
  },
  "plugins": [
    "/home/tomge/.local/share/opencode/packages/node_modules/oh-my-opencode",
    "/home/tomge/work/projects/dotfiles-arch/opencode/.config/opencode/local-plugins"
  ],
  "experimental": { "todo": true },
  "lsp": true,
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "/home/tomge/.config/opencode/node_modules/.bin/playwright-mcp",
          "--config",
          "/home/tomge/.config/opencode/playwright-mcp.json"
        ],
        "timeout": { "catalog": 60000, "execution": 60000 }
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"]
      }
    }
  },
  "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }]
}
