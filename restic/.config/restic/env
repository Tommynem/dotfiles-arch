# Repository location (new post-incident repository)
export RESTIC_REPOSITORY="/mnt/nas-pool/backup/restic-omarchy"

# Password file location
export RESTIC_PASSWORD_FILE="/home/tomge/.config/restic/password"

# Exclude file location
export RESTIC_EXCLUDE_FILE="/home/tomge/.config/restic/exclude.txt"

# Cache directory
export RESTIC_CACHE_DIR="/home/tomge/.cache/restic"

# Backup source directory
export BACKUP_SOURCE="/home/tomge"

# Optional: Set nice level for backup process (reduce CPU priority)
